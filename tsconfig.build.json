{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "jsx": "react-jsx",

    "declaration": true,
    "declarationMap": true,

    "strict": true,

    "types": ["react"]
  },

  "include": ["src/**/*"]
}